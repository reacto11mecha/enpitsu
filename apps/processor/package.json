{
  "name": "@enpitsu/processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo node_modules",
    "dev": "pnpm with-env tsx watch --import ./instrumentation.ts ./index.ts",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-pino": "^0.64.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@platejs/basic-nodes": "^49.0.0",
    "@slate-yjs/core": "^1.0.2",
    "@t3-oss/env-core": "^0.13.8",
    "bullmq": "^5.56.8",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "platejs": "^49.2.9",
    "yjs": "^13.6.27",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@enpitsu/db": "workspace:^0.1.0",
    "@enpitsu/eslint-config": "workspace:^0.2.0",
    "@enpitsu/prettier-config": "workspace:^0.1.0",
    "@enpitsu/redis": "workspace:^0.1.0",
    "@enpitsu/tsconfig": "workspace:^0.1.0",
    "@types/pino": "^7.0.5",
    "dotenv-cli": "^9.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "prettier": "@enpitsu/prettier-config"
}
